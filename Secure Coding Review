        "# TASK 3: SECURE CODING REVIEW\n",
        "# Python application security audit using simple static analysis\n",
        "\n",
        "import re\n",
        "\n",
        "# Sample Python application to audit\n",
        "code = '''\n",
        "import hashlib\n",
        "import subprocess\n",
        "import sqlite3\n",
        "\n",
        "username = input(\"Enter username: \")\n",
        "password = \"admin123\"\n",
        "\n",
        "query = \"SELECT * FROM users WHERE username = '\" + username + \"'\"\n",
        "conn = sqlite3.connect(\"users.db\")\n",
        "cursor = conn.cursor()\n",
        "cursor.execute(query)\n",
        "\n",
        "user_input = input(\"Enter expression: \")\n",
        "result = eval(user_input)\n",
        "\n",
        "subprocess.call(\"ping \" + username, shell=True)\n",
        "\n",
        "hash_value = hashlib.md5(password.encode()).hexdigest()\n",
        "'''\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"        TASK 3 - SECURE CODING REVIEW\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"\\nProgramming Language : Python\")\n",
        "print(\"Application           : User Authentication / Database Application\")\n",
        "print(\"Review Method         : Static Analysis + Manual Inspection\\n\")\n",
        "\n",
        "# Security rules\n",
        "checks = [\n",
        "    (\n",
        "        \"Hardcoded Password\",\n",
        "        r'password\\s*=\\s*[\"\\'].*[\"\\']',\n",
        "        \"High\",\n",
        "        \"Do not store passwords directly in source code.\",\n",
        "        \"Use environment variables or a secure password manager.\"\n",
        "    ),\n",
        "    (\n",
        "        \"SQL Injection\",\n",
        "        r'execute\\s*\\(.*\\+',\n",
        "        \"Critical\",\n",
        "        \"SQL query is created using user input through string concatenation.\",\n",
        "        \"Use parameterized SQL queries / prepared statements.\"\n",
        "    ),\n",
        "    (\n",
        "        \"Dangerous eval()\",\n",
        "        r'\\beval\\s*\\(',\n",
        "        \"High\",\n",
        "        \"eval() can execute attacker-controlled Python code.\",\n",
        "        \"Avoid eval(); use safe parsing or predefined operations.\"\n",
        "    ),\n",
        "    (\n",
        "        \"Command Injection\",\n",
        "        r'subprocess\\..*shell\\s*=\\s*True',\n",
        "        \"Critical\",\n",
        "        \"User-controlled data may be executed as an operating-system command.\",\n",
        "        \"Avoid shell=True and validate/allowlist command arguments.\"\n",
        "    ),\n",
        "    (\n",
        "        \"Weak MD5 Hash\",\n",
        "        r'\\bmd5\\s*\\(',\n",
        "        \"Medium\",\n",
        "        \"MD5 is not suitable for secure password storage.\",\n",
        "        \"Use Argon2, bcrypt, scrypt, or PBKDF2 with a unique salt.\"\n",
        "    )\n",
        "]\n",
        "\n",
        "findings = []\n",
        "\n",
        "for name, pattern, severity, problem, fix in checks:\n",
        "    if re.search(pattern, code, re.IGNORECASE):\n",
        "        findings.append((name, severity, problem, fix))\n",
        "\n",
        "# Display findings\n",
        "print(\"SECURITY FINDINGS\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "for i, (name, severity, problem, fix) in enumerate(findings, 1):\n",
        "    print(f\"\\n{i}. {name}\")\n",
        "    print(f\"   Severity       : {severity}\")\n",
        "    print(f\"   Vulnerability  : {problem}\")\n",
        "    print(f\"   Recommendation : {fix}\")\n",
        "\n",
        "# Summary\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"REVIEW SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Total vulnerabilities found : {len(findings)}\")\n",
        "\n",
        "severity_count = {}\n",
        "for _, severity, _, _ in findings:\n",
        "    severity_count[severity] = severity_count.get(severity, 0) + 1\n",
        "\n",
        "for severity in [\"Critical\", \"High\", \"Medium\", \"Low\"]:\n",
        "    if severity in severity_count:\n",
        "        print(f\"{severity:10}: {severity_count[severity]}\")\n",
        "\n",
        "print(\"\\nREMEDIATION STEPS\")\n",
        "print(\"-\" * 70)\n",
        "print(\"1. Remove hardcoded passwords and secrets.\")\n",
        "print(\"2. Use parameterized SQL queries to prevent SQL injection.\")\n",
        "print(\"3. Replace eval() with safe input processing.\")\n",
